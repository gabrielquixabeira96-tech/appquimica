# ─────────────────────────────────────────────────────────────
# Chaves de API do assistente virtual (TODAS OPCIONAIS)
#
# A plataforma funciona 100% sem nenhuma chave aqui: o aluno cola
# a própria chave em /config e ela fica só no navegador dele.
#
# Se você preencher abaixo, a chave vira o padrão do servidor e o
# aluno não precisa colar nada. NUNCA use prefixo NEXT_PUBLIC_ aqui —
# isso exporia a chave no bundle do navegador.
# ─────────────────────────────────────────────────────────────

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provedor padrão: gemini | openai | anthropic
NEXT_PUBLIC_DEFAULT_PROVIDER=gemini
